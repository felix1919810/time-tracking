# 飞书应用凭证 (open.feishu.cn/app -> 凭证与基础信息)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格 app_token (多维表格 URL: https://xxx.feishu.cn/base/{APP_TOKEN})
LARK_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 消息机器人 (群聊 chat_id 用于推送提醒)
LARK_NOTIFY_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 时区
TIMEZONE=Asia/Shanghai
